<?php

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Swatches\Model\Swatch;
use SR\SimpleProductLink\Block\Product\View\LinkedProducts as LinkedProductsBlock;
use SR\SimpleProductLink\ViewModel\LinkedProducts as LinkedProductsViewModel;

/** @var LinkedProductsBlock $block */
/** @var Escaper $escaper */

/** @var LinkedProductsViewModel $viewModel */
$viewModel = $block->getData('view_model');
$swatchMediaHelper = $viewModel->getSwatchMediaHelper();

$product = $block->getProduct();
if (!$product) {
    return;
}

$linkData = $viewModel->getLinkedProductData($product);
if (!$linkData) {
    return;
}
?>

<div class="sr-simple-product-link">
    <?php foreach ($linkData as $group): ?>
        <?php
        $options = $group['options'];
        $attributeLabel = $escaper->escapeHtml($group['attribute_label']);
        $currentOptionLabel = '';
        foreach ($options as $option) {
            if ($option['is_current']) {
                $currentOptionLabel = $escaper->escapeHtml($option['label']);
                break;
            }
        }
        ?>
        <div class="sr-simple-product-link__group">
            <p class="sr-simple-product-link__label">
                <?= $attributeLabel ?>:
                <span class="sr-simple-product-link__selected"><?= $currentOptionLabel ?></span>
            </p>
            <div class="sr-simple-product-link__options"
                 role="radiogroup"
                 aria-label="<?= $attributeLabel ?>">
                <?php foreach ($options as $option): ?>
                    <?php
                    $isCurrent = $option['is_current'];
                    $isSalable = $option['is_salable'];
                    $swatchType = (int)$option['swatch_type'];
                    $swatchValue = $option['swatch_value'];
                    $label = $escaper->escapeHtml($option['label']);
                    $url = $escaper->escapeUrl($option['url']);

                    $isColorSwatch = $swatchType === Swatch::SWATCH_TYPE_VISUAL_COLOR;
                    $isImageSwatch = $swatchType === Swatch::SWATCH_TYPE_VISUAL_IMAGE;
                    $isDropdownSwatch = $swatchType === LinkedProductsViewModel::SWATCH_TYPE_NONE;

                    $classes = [
                        'base' => 'sr-simple-product-link__option',
                        'type' => match (true) {
                            $isColorSwatch || $isImageSwatch => 'sr-simple-product-link__option--visual',
                            $isDropdownSwatch => 'sr-simple-product-link__option--dropdown',
                            default => 'sr-simple-product-link__option--text',
                        },
                        'state' => match (true) {
                            $isCurrent => 'sr-simple-product-link__option--current',
                            !$isSalable => 'sr-simple-product-link__option--disabled',
                            default => 'sr-simple-product-link__option--available',
                        },
                    ];
                    $classList = implode(' ', $classes);

                    $swatchStyle = match (true) {
                        $isColorSwatch => 'background-color:' . $swatchValue . ';',
                        $isImageSwatch && (bool)$swatchValue => sprintf(
                            'background-image:url(%s);background-size:cover;background-position:center;',
                            $escaper->escapeUrl(
                                $swatchMediaHelper->getSwatchAttributeImage(Swatch::SWATCH_IMAGE_NAME, $swatchValue)
                            )
                        ),
                        default => '',
                    };

                    $productImage = $escaper->escapeUrl($option['product_image'] ?? '');
                    $titleText = !$isSalable
                        ? $label . ' - ' . $escaper->escapeHtml(__('Out of Stock'))
                        : $label;
                    ?>

                    <?php if ($isSalable && !$isCurrent): ?>
                        <a href="<?= $url ?>"
                           class="<?= $classList ?>"
                           role="radio"
                           aria-checked="false"
                           aria-label="<?= $label ?>"
                           title="<?= $titleText ?>"
                           <?php if ($swatchStyle): ?>style="<?= $swatchStyle ?>"<?php endif; ?>
                        >
                            <?php if ($isDropdownSwatch && $productImage): ?>
                                <img src="<?= $productImage ?>"
                                     alt="<?= $label ?>"
                                     class="sr-simple-product-link__image"
                                     loading="lazy"
                                />
                            <?php elseif (!$isColorSwatch && !$isImageSwatch): ?>
                                <span class="sr-simple-product-link__text"><?= $label ?></span>
                            <?php endif; ?>
                        </a>
                    <?php else: ?>
                        <span class="<?= $classList ?>"
                              role="radio"
                              aria-checked="<?= $isCurrent ? 'true' : 'false' ?>"
                              aria-label="<?= $label ?>"
                              title="<?= $titleText ?>"
                              <?php if ($swatchStyle): ?>style="<?= $swatchStyle ?>"<?php endif; ?>
                        >
                            <?php if ($isDropdownSwatch && $productImage): ?>
                                <img src="<?= $productImage ?>"
                                     alt="<?= $label ?>"
                                     class="sr-simple-product-link__image"
                                     loading="lazy"
                                />
                            <?php elseif (!$isColorSwatch && !$isImageSwatch): ?>
                                <span class="sr-simple-product-link__text"><?= $label ?></span>
                            <?php endif; ?>

                            <?php if (!$isSalable): ?>
                                <svg class="sr-simple-product-link__strike"
                                     aria-hidden="true">
                                    <line x1="0"
                                          y1="100%"
                                          x2="100%"
                                          y2="0"
                                          class="sr-simple-product-link__strike-line"></line>
                                </svg>
                            <?php endif; ?>
                        </span>
                    <?php endif; ?>
                <?php endforeach; ?>
            </div>
        </div>
    <?php endforeach; ?>
</div>
