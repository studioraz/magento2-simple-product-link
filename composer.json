{
    "name": "studioraz/magento2-simple-product-link",
    "description": "Links simple products together and renders their variations on the PDP",
    "type": "magento2-module",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "SR\\SimpleProductLink\\": "src/SimpleProductLink",
            "SR\\SimpleProductLinkLuma\\": "src/SimpleProductLinkLuma"
        },
        "files": [
            "src/SimpleProductLink/registration.php",
            "src/SimpleProductLinkLuma/registration.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SR\\SimpleProductLink\\Test\\": "tests"
        }
    },
    "require": {
        "php": ">=8.1",
        "magento/framework": ">=103",
        "studioraz/magento2-base": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    }
}
